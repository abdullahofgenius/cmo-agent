# ---------------------------------------------------------------------------
# AI is OPTIONAL. With no keys set, the app runs fully on a free deterministic
# engine (scoring + agent team chat). Nothing costs money by default.
#
# To get richer, AI-written replies for FREE, plug any OpenAI-compatible
# provider by setting these three. The app calls  {AI_BASE_URL}/chat/completions
# ---------------------------------------------------------------------------

# 1) Google Gemini (free tier) — set base URL + your free API key from AI Studio
#    https://aistudio.google.com/app/apikey  (OpenAI-compatible endpoint)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# 2) Groq (free tier) — https://console.groq.com/keys  (very fast, free limits)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# 3) OpenRouter (free models) — https://openrouter.ai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Legacy OpenAI vars (still supported):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public product URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
